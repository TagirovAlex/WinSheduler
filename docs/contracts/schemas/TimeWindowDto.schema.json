{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winsheduler.local/schemas/TimeWindowDto.schema.json",
  "title": "TimeWindowDto",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "startDate",
    "endDate",
    "daysOfWeek",
    "daysOfMonth",
    "specificDates",
    "exactTimes",
    "startTime",
    "endTime",
    "repeatIntervalMinutes",
    "repeatUntil",
    "dayInterval",
    "weekInterval",
    "monthInterval"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "kind": {
      "type": "string",
      "enum": ["Once", "Daily", "Weekly", "Monthly", "Interval"]
    },
    "startDate": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "endDate": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "daysOfWeek": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
      }
    },
    "daysOfMonth": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 31 }
    },
    "specificDates": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
    },
    "exactTimes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
    },
    "startTime": {
      "type": ["string", "null"],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "endTime": {
      "type": ["string", "null"],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "repeatIntervalMinutes": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 1440
    },
    "repeatUntil": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "dayInterval": { "type": "integer", "minimum": 1, "maximum": 365 },
    "weekInterval": { "type": "integer", "minimum": 1, "maximum": 52 },
    "monthInterval": { "type": "integer", "minimum": 1, "maximum": 12 }
  }
}
