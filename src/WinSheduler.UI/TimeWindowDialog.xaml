<Window x:Class="WinSheduler.UI.TimeWindowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Триггер расписания"
        Width="540" MinWidth="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Тип триггера -->
                <GroupBox Header="Тип триггера" Margin="0,0,0,8">
                    <WrapPanel Margin="4,4,4,2">
                        <RadioButton x:Name="RadioOnce" GroupName="TriggerKind" Content="Однократно"
                                     Margin="0,0,16,4" Checked="Radio_Checked"/>
                        <RadioButton x:Name="RadioDaily" GroupName="TriggerKind" Content="Ежедневно"
                                     Margin="0,0,16,4" IsChecked="True" Checked="Radio_Checked"/>
                        <RadioButton x:Name="RadioWeekly" GroupName="TriggerKind" Content="Еженедельно"
                                     Margin="0,0,16,4" Checked="Radio_Checked"/>
                        <RadioButton x:Name="RadioMonthly" GroupName="TriggerKind" Content="Ежемесячно"
                                     Margin="0,0,16,4" Checked="Radio_Checked"/>
                        <RadioButton x:Name="RadioInterval" GroupName="TriggerKind" Content="Интервал"
                                     Margin="0,0,0,4" Checked="Radio_Checked"/>
                    </WrapPanel>
                </GroupBox>

                <!-- Параметры выбранного типа -->
                <GroupBox Header="Параметры" Margin="0,0,0,8">
                    <Grid Margin="4">

                        <!-- Однократно -->
                        <Grid x:Name="PanelOnce" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Дата:"/>
                            <DatePicker x:Name="OnceDatePicker" Grid.Row="0" Grid.Column="1"
                                        Margin="0,0,0,6" SelectedDateChanged="Field_Changed"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="Время (ЧЧ:ММ):"/>
                            <TextBox x:Name="OnceTimeBox" Grid.Row="1" Grid.Column="1" Width="80"
                                     HorizontalAlignment="Left" Text="18:00" TextChanged="Field_TextChanged"/>
                        </Grid>

                        <!-- Ежедневно -->
                        <Grid x:Name="PanelDaily" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Каждые:"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="DailyIntervalBox" Width="60" Text="1" TextChanged="Field_TextChanged"/>
                                <Label Content="дн." VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Label Grid.Row="1" Grid.Column="0" Content="Время (ЧЧ:ММ):"/>
                            <TextBox x:Name="DailyTimesBox" Grid.Row="1" Grid.Column="1" Text="09:00"
                                     TextChanged="Field_TextChanged"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="Несколько значений — через запятую, например: 09:00, 13:00, 18:00"/>
                        </Grid>

                        <!-- Еженедельно -->
                        <Grid x:Name="PanelWeekly" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Каждые:"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="WeeklyIntervalBox" Width="60" Text="1" TextChanged="Field_TextChanged"/>
                                <Label Content="нед." VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Label Grid.Row="1" Grid.Column="0" Content="Дни недели:"/>
                            <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                                <CheckBox x:Name="MonBox" Content="Пн" Margin="0,0,10,0" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="TueBox" Content="Вт" Margin="0,0,10,0" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="WedBox" Content="Ср" Margin="0,0,10,0" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="ThuBox" Content="Чт" Margin="0,0,10,0" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="FriBox" Content="Пт" Margin="0,0,10,0" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="SatBox" Content="Сб" Margin="0,0,10,0" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="SunBox" Content="Вс" Checked="Field_Changed" Unchecked="Field_Changed"/>
                            </WrapPanel>
                            <Label Grid.Row="2" Grid.Column="0" Content="Время (ЧЧ:ММ):"/>
                            <TextBox x:Name="WeeklyTimesBox" Grid.Row="2" Grid.Column="1" Text="09:00"
                                     TextChanged="Field_TextChanged"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="Несколько значений — через запятую, например: 09:00, 13:00"/>
                        </Grid>

                        <!-- Ежемесячно -->
                        <Grid x:Name="PanelMonthly" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="День месяца:"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="MonthlyDayBox" Width="60" Text="1" TextChanged="Field_TextChanged"/>
                                <Label Content="(1–31)" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Label Grid.Row="1" Grid.Column="0" Content="Каждые:"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="MonthlyIntervalBox" Width="60" Text="1" TextChanged="Field_TextChanged"/>
                                <Label Content="мес." VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Label Grid.Row="2" Grid.Column="0" Content="Время (ЧЧ:ММ):"/>
                            <TextBox x:Name="MonthlyTimesBox" Grid.Row="2" Grid.Column="1" Text="09:00"
                                     TextChanged="Field_TextChanged"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="Несколько значений — через запятую, например: 09:00, 18:00"/>
                        </Grid>

                        <!-- Интервал -->
                        <Grid x:Name="PanelInterval" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Начало (ЧЧ:ММ):"/>
                            <TextBox x:Name="IntervalStartBox" Grid.Row="0" Grid.Column="1" Width="80"
                                     HorizontalAlignment="Left" Text="09:00" Margin="0,0,0,6"
                                     TextChanged="Field_TextChanged"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="Конец (ЧЧ:ММ):"/>
                            <TextBox x:Name="IntervalEndBox" Grid.Row="1" Grid.Column="1" Width="80"
                                     HorizontalAlignment="Left" Text="18:00" Margin="0,0,0,6"
                                     TextChanged="Field_TextChanged"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="Каждые:"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="IntervalRepeatBox" Width="60" Text="30" TextChanged="Field_TextChanged"/>
                                <Label Content="мин." VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="От 1 до 1440 минут. Например: с 09:00 до 18:00 каждые 30 минут."/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- Общие ограничения -->
                <GroupBox Header="Ограничения" Margin="0,0,0,8">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Дата начала:"/>
                        <DatePicker x:Name="StartDatePicker" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6"
                                    SelectedDateChanged="Field_Changed"/>
                        <Label Grid.Row="0" Grid.Column="2" Content="Дата конца:" Margin="0,0,8,0"/>
                        <DatePicker x:Name="EndDatePicker" Grid.Row="0" Grid.Column="3" Margin="0,0,0,6"
                                    SelectedDateChanged="Field_Changed"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Повторять до:"/>
                        <DatePicker x:Name="RepeatUntilPicker" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"
                                    SelectedDateChanged="Field_Changed"/>
                        <TextBox x:Name="RepeatUntilTimeBox" Grid.Row="1" Grid.Column="2" Width="70"
                                 Text="23:59" ToolTip="Время окончания повторов в формате ЧЧ:ММ"
                                 TextChanged="Field_TextChanged"/>

                        <CheckBox x:Name="EnabledCheck" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                  Content="Включено" IsChecked="True" Margin="0,8,0,0"
                                  Checked="Field_Changed" Unchecked="Field_Changed"/>
                    </Grid>
                </GroupBox>

                <!-- Предпросмотр -->
                <GroupBox Header="Предпросмотр" Margin="0,0,0,8">
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="4"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                </GroupBox>

                <!-- Ошибка валидации -->
                <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="#C42B1C" Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkBtn" Content="OK" MinWidth="90" Padding="12,4" Margin="0,0,8,0"
                    IsDefault="True" Click="OkBtn_Click"/>
            <Button x:Name="CancelBtn" Content="Отмена" MinWidth="90" Padding="12,4"
                    IsCancel="True" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
