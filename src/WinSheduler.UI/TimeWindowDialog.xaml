<Window x:Class="WinSheduler.UI.TimeWindowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WinSheduler.UI.Localization"
        Title="{loc:Loc Trigger_Title}"
        Width="540" MinWidth="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Тип триггера -->
                <GroupBox Header="{loc:Loc Trigger_TypeGroup}" Margin="0,0,0,8">
                    <WrapPanel Margin="4,4,4,2">
                        <RadioButton x:Name="RadioOnce" GroupName="TriggerKind" Content="{loc:Loc TriggerKind_Once}"
                                     Margin="0,0,16,4" Checked="Radio_Checked"/>
                        <RadioButton x:Name="RadioDaily" GroupName="TriggerKind" Content="{loc:Loc TriggerKind_Daily}"
                                     Margin="0,0,16,4" IsChecked="True" Checked="Radio_Checked"/>
                        <RadioButton x:Name="RadioWeekly" GroupName="TriggerKind" Content="{loc:Loc TriggerKind_Weekly}"
                                     Margin="0,0,16,4" Checked="Radio_Checked"/>
                        <RadioButton x:Name="RadioMonthly" GroupName="TriggerKind" Content="{loc:Loc TriggerKind_Monthly}"
                                     Margin="0,0,16,4" Checked="Radio_Checked"/>
                        <RadioButton x:Name="RadioInterval" GroupName="TriggerKind" Content="{loc:Loc TriggerKind_Interval}"
                                     Margin="0,0,0,4" Checked="Radio_Checked"/>
                    </WrapPanel>
                </GroupBox>

                <!-- Параметры выбранного типа -->
                <GroupBox Header="{loc:Loc Trigger_ParamsGroup}" Margin="0,0,0,8">
                    <Grid Margin="4">

                        <!-- Однократно -->
                        <Grid x:Name="PanelOnce" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc Trigger_Date}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=OnceDatePicker}"/>
                            <DatePicker x:Name="OnceDatePicker" Grid.Row="0" Grid.Column="1"
                                        Margin="0,0,0,6" SelectedDateChanged="Field_Changed"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc Trigger_Time}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=OnceTimeBox}"/>
                            <TextBox x:Name="OnceTimeBox" Grid.Row="1" Grid.Column="1" Width="80"
                                     HorizontalAlignment="Left" Text="18:00"
                                     Style="{StaticResource FormTextBox}"
                                     TextChanged="Field_TextChanged"/>
                        </Grid>

                        <!-- Ежедневно -->
                        <Grid x:Name="PanelDaily" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc Trigger_Every}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=DailyIntervalBox}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="DailyIntervalBox" Width="60" Text="1"
                                         Style="{StaticResource FormTextBox}"
                                         TextChanged="Field_TextChanged"/>
                                <TextBlock Text="{loc:Loc Trigger_UnitDays}" Style="{StaticResource CaptionText}"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                            <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc Trigger_Time}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=DailyTimesBox}"/>
                            <TextBox x:Name="DailyTimesBox" Grid.Row="1" Grid.Column="1" Text="09:00"
                                     Style="{StaticResource FormTextBox}"
                                     TextChanged="Field_TextChanged"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionText}"
                                       Text="{loc:Loc Trigger_TimesHint}"/>
                        </Grid>

                        <!-- Еженедельно -->
                        <Grid x:Name="PanelWeekly" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc Trigger_Every}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=WeeklyIntervalBox}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="WeeklyIntervalBox" Width="60" Text="1"
                                         Style="{StaticResource FormTextBox}"
                                         TextChanged="Field_TextChanged"/>
                                <TextBlock Text="{loc:Loc Trigger_UnitWeeks}" Style="{StaticResource CaptionText}"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                            <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc Trigger_DaysOfWeek}"
                                   Style="{StaticResource FormLabel}"/>
                            <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                                <CheckBox x:Name="MonBox" Content="{loc:Loc DayShort_Monday}" Margin="0,0,10,0"
                                          Style="{StaticResource FormCheckBox}" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="TueBox" Content="{loc:Loc DayShort_Tuesday}" Margin="0,0,10,0"
                                          Style="{StaticResource FormCheckBox}" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="WedBox" Content="{loc:Loc DayShort_Wednesday}" Margin="0,0,10,0"
                                          Style="{StaticResource FormCheckBox}" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="ThuBox" Content="{loc:Loc DayShort_Thursday}" Margin="0,0,10,0"
                                          Style="{StaticResource FormCheckBox}" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="FriBox" Content="{loc:Loc DayShort_Friday}" Margin="0,0,10,0"
                                          Style="{StaticResource FormCheckBox}" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="SatBox" Content="{loc:Loc DayShort_Saturday}" Margin="0,0,10,0"
                                          Style="{StaticResource FormCheckBox}" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                <CheckBox x:Name="SunBox" Content="{loc:Loc DayShort_Sunday}"
                                          Style="{StaticResource FormCheckBox}" Checked="Field_Changed" Unchecked="Field_Changed"/>
                            </WrapPanel>
                            <Label Grid.Row="2" Grid.Column="0" Content="{loc:Loc Trigger_Time}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=WeeklyTimesBox}"/>
                            <TextBox x:Name="WeeklyTimesBox" Grid.Row="2" Grid.Column="1" Text="09:00"
                                     Style="{StaticResource FormTextBox}"
                                     TextChanged="Field_TextChanged"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionText}"
                                       Text="{loc:Loc Trigger_TimesHint}"/>
                        </Grid>

                        <!-- Ежемесячно -->
                        <Grid x:Name="PanelMonthly" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc Trigger_DayOfMonth}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=MonthlyDayBox}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="MonthlyDayBox" Width="60" Text="1"
                                         Style="{StaticResource FormTextBox}"
                                         TextChanged="Field_TextChanged"/>
                                <TextBlock Text="{loc:Loc Trigger_DayRange}" Style="{StaticResource CaptionText}"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                            <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc Trigger_Every}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=MonthlyIntervalBox}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="MonthlyIntervalBox" Width="60" Text="1"
                                         Style="{StaticResource FormTextBox}"
                                         TextChanged="Field_TextChanged"/>
                                <TextBlock Text="{loc:Loc Trigger_UnitMonths}" Style="{StaticResource CaptionText}"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                            <Label Grid.Row="2" Grid.Column="0" Content="{loc:Loc Trigger_Time}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=MonthlyTimesBox}"/>
                            <TextBox x:Name="MonthlyTimesBox" Grid.Row="2" Grid.Column="1" Text="09:00"
                                     Style="{StaticResource FormTextBox}"
                                     TextChanged="Field_TextChanged"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionText}"
                                       Text="{loc:Loc Trigger_TimesHint}"/>
                        </Grid>

                        <!-- Интервал -->
                        <Grid x:Name="PanelInterval" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc Trigger_Start}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=IntervalStartBox}"/>
                            <TextBox x:Name="IntervalStartBox" Grid.Row="0" Grid.Column="1" Width="80"
                                     HorizontalAlignment="Left" Text="09:00" Margin="0,0,0,6"
                                     Style="{StaticResource FormTextBox}"
                                     TextChanged="Field_TextChanged"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc Trigger_End}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=IntervalEndBox}"/>
                            <TextBox x:Name="IntervalEndBox" Grid.Row="1" Grid.Column="1" Width="80"
                                     HorizontalAlignment="Left" Text="18:00" Margin="0,0,0,6"
                                     Style="{StaticResource FormTextBox}"
                                     TextChanged="Field_TextChanged"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="{loc:Loc Trigger_Every}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=IntervalRepeatBox}"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="IntervalRepeatBox" Width="60" Text="30"
                                         Style="{StaticResource FormTextBox}"
                                         TextChanged="Field_TextChanged"/>
                                <TextBlock Text="{loc:Loc Trigger_UnitMinutes}" Style="{StaticResource CaptionText}"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionText}"
                                       Text="{loc:Loc Trigger_IntervalHint}"/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- Общие ограничения -->
                <GroupBox Header="{loc:Loc Trigger_LimitsGroup}" Margin="0,0,0,8">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc Trigger_StartDate}"
                               Style="{StaticResource FormLabel}" Target="{Binding ElementName=StartDatePicker}"/>
                        <DatePicker x:Name="StartDatePicker" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6"
                                    SelectedDateChanged="Field_Changed"/>
                        <Label Grid.Row="0" Grid.Column="2" Content="{loc:Loc Trigger_EndDate}"
                               Style="{StaticResource FormLabel}" Target="{Binding ElementName=EndDatePicker}"
                               Margin="0,0,8,0"/>
                        <DatePicker x:Name="EndDatePicker" Grid.Row="0" Grid.Column="3" Margin="0,0,0,6"
                                    SelectedDateChanged="Field_Changed"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc Trigger_RepeatUntil}"
                               Style="{StaticResource FormLabel}" Target="{Binding ElementName=RepeatUntilPicker}"/>
                        <DatePicker x:Name="RepeatUntilPicker" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"
                                    SelectedDateChanged="Field_Changed"/>
                        <TextBox x:Name="RepeatUntilTimeBox" Grid.Row="1" Grid.Column="2" Width="70"
                                 Text="23:59" ToolTip="{loc:Loc Trigger_RepeatUntilTooltip}"
                                 Style="{StaticResource FormTextBox}"
                                 TextChanged="Field_TextChanged"/>

                        <CheckBox x:Name="EnabledCheck" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                  Content="{loc:Loc Trigger_Enabled}" IsChecked="True" Margin="0,8,0,0"
                                  Style="{StaticResource FormCheckBox}"
                                  Checked="Field_Changed" Unchecked="Field_Changed"/>
                    </Grid>
                </GroupBox>

                <!-- Предпросмотр -->
                <GroupBox Header="{loc:Loc Trigger_PreviewGroup}" Margin="0,0,0,8">
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="4"
                               Style="{StaticResource CaptionText}"/>
                </GroupBox>

                <!-- Ошибка валидации -->
                <Border x:Name="ErrorBanner" Style="{StaticResource StatusBannerError}" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkBtn" Content="{loc:Loc Common_Ok}"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="OkBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="CancelBtn" Content="{loc:Loc Common_Cancel}"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
