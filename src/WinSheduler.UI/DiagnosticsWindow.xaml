<Window x:Class="WinSheduler.UI.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диагностика" Width="560" MinWidth="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="BannerText" Grid.Row="0" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="#C42B1C" Margin="0,0,0,8"/>

        <GroupBox Grid.Row="1" Header="Состояние">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Подключение:" Margin="0,0,0,4"/>
                <TextBlock x:Name="ConnectionText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Служба:" Margin="0,0,0,4"/>
                <TextBlock x:Name="ServiceStateText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Версия службы:" Margin="0,0,0,4"/>
                <TextBlock x:Name="ServiceVersionText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Версия интерфейса:" Margin="0,0,0,4"/>
                <TextBlock x:Name="UiVersionText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Время работы службы:" Margin="0,0,0,4"/>
                <TextBlock x:Name="UptimeText" Grid.Row="4" Grid.Column="1" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Задач / выполняется:" Margin="0,0,0,4"/>
                <TextBlock x:Name="TaskCountText" Grid.Row="5" Grid.Column="1" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Роль:" Margin="0,0,0,4"/>
                <TextBlock x:Name="RoleText" Grid.Row="6" Grid.Column="1" Margin="0,0,0,4"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RefreshBtn" Content="Обновить" MinWidth="90" Padding="12,4"
                    Margin="0,0,8,0" Click="RefreshBtn_Click"/>
            <Button x:Name="CopyBtn" Content="Копировать сведения" MinWidth="140" Padding="12,4"
                    Margin="0,0,8,0" Click="CopyBtn_Click"/>
            <Button Content="Закрыть" MinWidth="90" Padding="12,4" IsCancel="True" Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
