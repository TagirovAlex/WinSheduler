<Window x:Class="WinSheduler.UI.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WinSheduler.UI.Localization"
        Title="{loc:Loc Diagnostics_Title}" Width="620" MinWidth="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App_BackgroundBrush}"
        Foreground="{DynamicResource App_ForegroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="Banner" Grid.Row="0" Style="{StaticResource StatusBannerError}" Visibility="Collapsed">
            <TextBlock x:Name="BannerText" TextWrapping="Wrap"/>
        </Border>

        <GroupBox Grid.Row="1" Header="{loc:Loc Diagnostics_GroupState}">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Diagnostics_Connection}"
                           Style="{StaticResource CaptionText}"/>
                <TextBlock x:Name="ConnectionText" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Diagnostics_Service}"
                           Style="{StaticResource CaptionText}"/>
                <TextBlock x:Name="ServiceStateText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Diagnostics_ServiceVersion}"
                           Style="{StaticResource CaptionText}"/>
                <TextBlock x:Name="ServiceVersionText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Diagnostics_UiVersion}"
                           Style="{StaticResource CaptionText}"/>
                <TextBlock x:Name="UiVersionText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Diagnostics_Uptime}"
                           Style="{StaticResource CaptionText}"/>
                <TextBlock x:Name="UptimeText" Grid.Row="4" Grid.Column="1" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Diagnostics_Tasks}"
                           Style="{StaticResource CaptionText}"/>
                <TextBlock x:Name="TaskCountText" Grid.Row="5" Grid.Column="1" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc Diagnostics_Role}"
                           Style="{StaticResource CaptionText}"/>
                <TextBlock x:Name="RoleText" Grid.Row="6" Grid.Column="1" Margin="0,0,0,4"/>
            </Grid>
        </GroupBox>

        <GroupBox x:Name="PathsGroup" Grid.Row="2" Header="{loc:Loc Diagnostics_PathsGroup}"
                  Visibility="Collapsed">
            <TextBlock x:Name="PathsText" TextWrapping="Wrap" Margin="4"
                       Style="{StaticResource CaptionText}"/>
        </GroupBox>

        <GroupBox x:Name="AuditGroup" Grid.Row="3" Header="{loc:Loc Diagnostics_AuditGroup}"
                  Visibility="Collapsed">
            <StackPanel Margin="4">
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="{loc:Loc Diagnostics_AuditFrom}" Style="{StaticResource CaptionText}"
                               Margin="0,0,6,0"/>
                    <DatePicker x:Name="AuditFromPicker" Width="130" Margin="0,0,12,0"/>
                    <TextBlock Text="{loc:Loc Diagnostics_AuditTo}" Style="{StaticResource CaptionText}"
                               Margin="0,0,6,0"/>
                    <DatePicker x:Name="AuditToPicker" Width="130" Margin="0,0,12,0"/>
                    <Button x:Name="AuditLoadBtn"
                            Style="{StaticResource ToolbarButton}" Click="AuditLoadBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconJournal}" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{loc:Loc Diagnostics_AuditLoad}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <TextBlock x:Name="AuditStatusText" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>

                <DataGrid x:Name="AuditGrid" Style="{StaticResource DataGridStyle}"
                          Height="180" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Diagnostics_AuditColumnTime}"
                                            Width="150"
                                            Binding="{Binding Timestamp, Converter={StaticResource LocalDateTimeConverter}, ConverterParameter=dd.MM.yyyy HH:mm:ss}"/>
                        <DataGridTextColumn Header="{loc:Loc Diagnostics_AuditColumnAction}"
                                            Width="140" Binding="{Binding Action}"/>
                        <DataGridTextColumn Header="{loc:Loc Diagnostics_AuditColumnResult}"
                                            Width="90" Binding="{Binding Result}"/>
                        <DataGridTextColumn Header="{loc:Loc Diagnostics_AuditColumnDetails}"
                                            Width="*" Binding="{Binding Details}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RefreshBtn"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RefreshBtn_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconRefresh}" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{loc:Loc Common_Refresh}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="CopyBtn"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CopyBtn_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconSave}" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{loc:Loc Diagnostics_Copy}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SecondaryButton}"
                    IsCancel="True" Click="CloseBtn_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconCancel}" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{loc:Loc Common_Close}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
