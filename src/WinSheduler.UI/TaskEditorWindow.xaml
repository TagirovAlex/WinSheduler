<Window x:Class="WinSheduler.UI.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WinSheduler.UI.Localization"
        Title="{loc:Loc Editor_TitleNew}" Height="560" Width="660"
        MinHeight="400" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App_BackgroundBrush}"
        Foreground="{DynamicResource App_ForegroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- Вкладка: Основные -->
            <TabItem Header="{loc:Loc Editor_TabGeneral}">
                <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc Editor_LabelName}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=NameBox}"/>
                            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                     Style="{StaticResource FormTextBox}" MaxLength="200"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc Editor_LabelDescription}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=DescBox}"/>
                            <TextBox x:Name="DescBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     Style="{StaticResource FormTextBox}" MaxLength="2000"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="{loc:Loc Editor_LabelProgram}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=PathBox}"/>
                            <TextBox x:Name="PathBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FormTextBox}"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="{loc:Loc Common_Browse}"
                                    Style="{StaticResource SecondaryButton}" Click="BrowseBtn_Click"
                                    Margin="4"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="{loc:Loc Editor_LabelArguments}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=ArgsBox}"/>
                            <TextBox x:Name="ArgsBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                     Style="{StaticResource FormTextBox}"/>

                            <Label Grid.Row="4" Grid.Column="0" Content="{loc:Loc Editor_LabelWorkingDirectory}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=WorkDirBox}"/>
                            <TextBox x:Name="WorkDirBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                     Style="{StaticResource FormTextBox}"/>

                            <Label Grid.Row="5" Grid.Column="0" Content="{loc:Loc Editor_LabelWindowStyle}"
                                   Style="{StaticResource FormLabel}" Target="{Binding ElementName=WindowStyleBox}"/>
                            <ComboBox x:Name="WindowStyleBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                      Style="{StaticResource FormComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumTextConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Text="{loc:Loc Editor_HeadlessHint}"/>

                            <GroupBox x:Name="RunAsGroup" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                                      Header="{loc:Loc Editor_RunAsGroup}" Margin="0,8,0,0">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc Editor_LabelUser}"
                                           Style="{StaticResource FormLabel}" Target="{Binding ElementName=RunAsUserBox}"/>
                                    <TextBox x:Name="RunAsUserBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                             Style="{StaticResource FormTextBox}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc Editor_LabelDomain}"
                                           Style="{StaticResource FormLabel}" Target="{Binding ElementName=RunAsDomainBox}"/>
                                    <TextBox x:Name="RunAsDomainBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                             Style="{StaticResource FormTextBox}"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="{loc:Loc Editor_LabelPassword}"
                                           Style="{StaticResource FormLabel}" Target="{Binding ElementName=RunAsPasswordBox}"/>
                                    <PasswordBox x:Name="RunAsPasswordBox" Grid.Row="2" Grid.Column="1"
                                                 Style="{StaticResource FormPasswordBox}"
                                                 PasswordChanged="RunAsPasswordBox_PasswordChanged"/>
                                    <Button x:Name="ClearPasswordBtn" Grid.Row="2" Grid.Column="2"
                                            Content="{loc:Loc Editor_ClearPassword}"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="ClearPasswordBtn_Click"
                                            Margin="4"/>

                                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal">
                                        <TextBlock x:Name="PasswordStateText" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="  "/>
                                        <Border x:Name="AdminBadge" Style="{StaticResource StatusBannerWarning}"
                                                Padding="8,2" Visibility="Collapsed">
                                            <TextBlock Text="{loc:Loc Editor_RequiresAdminHint}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка: Расписание -->
            <TabItem Header="{loc:Loc Editor_TabSchedule}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button x:Name="AddTimeBtn" Content="{loc:Loc Editor_AddTrigger}"
                                Style="{StaticResource ToolbarButton}" Click="AddTimeBtn_Click"
                                Margin="0,0,6,0"/>
                        <Button x:Name="EditTimeBtn" Content="{loc:Loc Common_Edit}"
                                Style="{StaticResource ToolbarButton}" Click="EditTimeBtn_Click"
                                Margin="0,0,6,0" IsEnabled="False"/>
                        <Button x:Name="DuplicateTimeBtn" Content="{loc:Loc Editor_DuplicateTrigger}"
                                Style="{StaticResource ToolbarButton}" Click="DuplicateTimeBtn_Click"
                                Margin="0,0,6,0" IsEnabled="False"/>
                        <Button x:Name="RemoveTimeBtn" Content="{loc:Loc Common_Delete}"
                                Style="{StaticResource DangerButton}" Click="RemoveTimeBtn_Click"
                                IsEnabled="False"/>
                    </WrapPanel>

                    <Grid Grid.Row="1">
                        <ListView x:Name="TimeWindowList"
                                  Background="{DynamicResource App_SurfaceBrush}"
                                  Foreground="{DynamicResource App_ForegroundBrush}"
                                  BorderBrush="{DynamicResource App_BorderBrush}"
                                  SelectionChanged="TimeWindowList_SelectionChanged"
                                  MouseDoubleClick="TimeWindowList_MouseDoubleClick"
                                  PreviewKeyDown="TimeWindowList_PreviewKeyDown"
                                  PreviewMouseRightButtonDown="TimeWindowList_PreviewMouseRightButtonDown">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc Common_Edit}" Click="EditTimeBtn_Click"/>
                                    <MenuItem Header="{loc:Loc Editor_DuplicateTrigger}" Click="DuplicateTimeBtn_Click"/>
                                    <MenuItem Header="{loc:Loc Common_Delete}" Click="RemoveTimeBtn_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{loc:Loc Editor_ColumnType}"
                                                    DisplayMemberBinding="{Binding TypeDisplay}" Width="130"/>
                                    <GridViewColumn Header="{loc:Loc Editor_ColumnSchedule}"
                                                    DisplayMemberBinding="{Binding Summary}" Width="420"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock x:Name="TimeWindowEmptyText" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource App_SecondaryTextBrush}"
                                   Text="{loc:Loc Editor_TriggersEmpty}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка: Параметры -->
            <TabItem Header="{loc:Loc Editor_TabOptions}">
                <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc Editor_LabelOnError}"
                               Style="{StaticResource FormLabel}" Target="{Binding ElementName=OnErrorBox}"/>
                        <ComboBox x:Name="OnErrorBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                  Style="{StaticResource FormComboBox}" SelectionChanged="OnErrorBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumTextConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Label x:Name="RetryLabel" Grid.Row="1" Grid.Column="0"
                               Content="{loc:Loc Editor_LabelRetryCount}"
                               Style="{StaticResource FormLabel}" Target="{Binding ElementName=RetryCountBox}"
                               Visibility="Collapsed"/>
                        <TextBox x:Name="RetryCountBox" Grid.Row="1" Grid.Column="1" Width="80"
                                 HorizontalAlignment="Left" Style="{StaticResource FormTextBox}"
                                 Visibility="Collapsed"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="{loc:Loc Editor_LabelOnOverlap}"
                               Style="{StaticResource FormLabel}" Target="{Binding ElementName=OnOverlapBox}"/>
                        <ComboBox x:Name="OnOverlapBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                  Style="{StaticResource FormComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumTextConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Label Grid.Row="3" Grid.Column="0" Content="{loc:Loc Editor_LabelTimeout}"
                               Style="{StaticResource FormLabel}" Target="{Binding ElementName=TimeoutBox}"/>
                        <TextBox x:Name="TimeoutBox" Grid.Row="3" Grid.Column="1" Width="100"
                                 HorizontalAlignment="Left" Style="{StaticResource FormTextBox}"/>

                        <CheckBox x:Name="KillOnTimeoutBox" Grid.Row="4" Grid.Column="1"
                                  Content="{loc:Loc Editor_KillOnTimeout}"
                                  Style="{StaticResource FormCheckBox}"/>

                        <CheckBox x:Name="LogOutputBox" Grid.Row="5" Grid.Column="1"
                                  Content="{loc:Loc Editor_LogOutput}"
                                  Style="{StaticResource FormCheckBox}"/>

                        <Label Grid.Row="6" Grid.Column="0" Content="{loc:Loc Editor_LabelMaxHistory}"
                               Style="{StaticResource FormLabel}" Target="{Binding ElementName=MaxHistoryBox}"/>
                        <TextBox x:Name="MaxHistoryBox" Grid.Row="6" Grid.Column="1" Width="100"
                                 HorizontalAlignment="Left" Style="{StaticResource FormTextBox}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border x:Name="ErrorBanner" Grid.Row="1" Style="{StaticResource StatusBannerError}"
                Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveBtn" Content="{loc:Loc Common_Save}"
                    Style="{StaticResource PrimaryButton}" Click="SaveBtn_Click"
                    IsDefault="True" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="CancelBtn" Content="{loc:Loc Common_Cancel}"
                    Style="{StaticResource SecondaryButton}" Click="CancelBtn_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
