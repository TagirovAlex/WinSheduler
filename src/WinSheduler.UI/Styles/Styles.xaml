<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Точка входа дизайн-системы. Подключается один раз в App.xaml.
        Порядок важен: Tokens и тема должны быть загружены раньше Controls,
        потому что стили используют StaticResource для метрик.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Theme.Light.xaml" />
        <ResourceDictionary Source="IconFont.xaml" />
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
