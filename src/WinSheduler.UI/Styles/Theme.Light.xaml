<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Стандартная светлая схема Windows (как у WinForms).
        Используются системные цвета, поэтому палитра совпадает с системой
        и не конфликтует с полями ввода и списками.
    -->

    <SolidColorBrush x:Key="App_BackgroundBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="App_SurfaceBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="App_ForegroundBrush" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="App_SecondaryTextBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="App_DisabledTextBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="App_BorderBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="App_ToolbarBackgroundBrush" Color="{x:Static SystemColors.ControlColor}" />

    <SolidColorBrush x:Key="App_ControlBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="App_ControlBorderBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="App_ControlHoverBrush" Color="{x:Static SystemColors.ControlLightColor}" />
    <SolidColorBrush x:Key="App_ControlPressedBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="App_ControlDisabledBrush" Color="{x:Static SystemColors.ControlColor}" />

    <!--
        Мягкое выделение строки: системный синий делает цветной текст статуса
        (зелёный/красный) нечитаемым. Светлая заливка сохраняет контраст.
    -->
    <SolidColorBrush x:Key="App_SelectionBrush" Color="#CCE8FF" />
    <SolidColorBrush x:Key="App_SelectionTextBrush" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="App_AccentBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="App_AccentTextBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="App_FocusBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="App_LinkBrush" Color="{x:Static SystemColors.HotTrackColor}" />

    <SolidColorBrush x:Key="App_GridHeaderBackgroundBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="App_GridAlternateRowBrush" Color="{x:Static SystemColors.ControlLightLightColor}" />
    <SolidColorBrush x:Key="App_GridRowHoverBrush" Color="{x:Static SystemColors.ControlLightColor}" />

    <SolidColorBrush x:Key="Status_SuccessBrush" Color="#107C10" />
    <SolidColorBrush x:Key="Status_ErrorBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="Status_WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="Status_SuccessBackgroundBrush" Color="#DFF6DD" />
    <SolidColorBrush x:Key="Status_ErrorBackgroundBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="Status_WarningBackgroundBrush" Color="#FFF4CE" />
    <SolidColorBrush x:Key="Status_InfoBackgroundBrush" Color="#E5F1FB" />

</ResourceDictionary>
