<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Тёмная тема. Цвета статусов осветлены относительно токенов
        #107C10/#C42B1C/#9D5D00: на тёмном фоне исходные значения
        не дают контраста 4.5:1 (контракт UI.md, раздел 7).
    -->

    <SolidColorBrush x:Key="App_BackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="App_SurfaceBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="App_ForegroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="App_SecondaryTextBrush" Color="#C0C0C0" />
    <SolidColorBrush x:Key="App_DisabledTextBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="App_BorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="App_ToolbarBackgroundBrush" Color="#262626" />

    <SolidColorBrush x:Key="App_ControlBackgroundBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="App_ControlBorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="App_ControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="App_ControlPressedBrush" Color="#454545" />
    <SolidColorBrush x:Key="App_ControlDisabledBrush" Color="#262626" />

    <SolidColorBrush x:Key="App_SelectionBrush" Color="#094771" />
    <SolidColorBrush x:Key="App_SelectionTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App_AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="App_AccentTextBrush" Color="#00131F" />
    <SolidColorBrush x:Key="App_FocusBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="App_LinkBrush" Color="#6CB8F0" />

    <SolidColorBrush x:Key="App_GridHeaderBackgroundBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="App_GridAlternateRowBrush" Color="#252525" />
    <SolidColorBrush x:Key="App_GridRowHoverBrush" Color="#333333" />

    <SolidColorBrush x:Key="Status_SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="Status_ErrorBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="Status_WarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="Status_SuccessBackgroundBrush" Color="#14301A" />
    <SolidColorBrush x:Key="Status_ErrorBackgroundBrush" Color="#3B1A1D" />
    <SolidColorBrush x:Key="Status_WarningBackgroundBrush" Color="#3D3517" />
    <SolidColorBrush x:Key="Status_InfoBackgroundBrush" Color="#1A2E3D" />

</ResourceDictionary>
