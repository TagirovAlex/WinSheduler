<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Токены нужны для StaticResource внутри этого словаря:
         ресурсы соседнего merged-словаря здесь не видны. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Стили контролов дизайн-системы (контракт UI.md, раздел 2).
        Кисти темы подключаются через DynamicResource, метрики — через StaticResource
        из Tokens.xaml. Прямые цвета в стилях запрещены.
    -->

    <!-- ===== Фокус ===== -->

    <Style x:Key="Control_FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2"
                               RadiusX="4"
                               RadiusY="4"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource App_FocusBrush}"
                               StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Кнопки ===== -->

    <ControlTemplate x:Key="ButtonTemplate_Secondary" TargetType="Button">
        <Border x:Name="Chrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Corner_Radius}"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App_ControlHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App_ControlPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App_ControlDisabledBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource App_DisabledTextBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ButtonTemplate_Accent" TargetType="Button">
        <Grid>
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Corner_Radius}"
                    SnapsToDevicePixels="True" />
            <Border x:Name="Overlay"
                    Background="Black"
                    CornerRadius="{StaticResource Corner_Radius}"
                    Opacity="0"
                    SnapsToDevicePixels="True" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Overlay" Property="Opacity" Value="0.12" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Overlay" Property="Opacity" Value="0.22" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App_ControlDisabledBrush}" />
                <Setter TargetName="Overlay" Property="Opacity" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource App_DisabledTextBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ButtonTemplate_Toolbar" TargetType="Button">
        <Border x:Name="Chrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Corner_Radius}"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App_ControlHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App_ControlPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource App_DisabledTextBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Control_Height}" />
        <Setter Property="MinWidth" Value="{StaticResource Button_MinWidth}" />
        <Setter Property="Padding" Value="{StaticResource Padding_Button}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Font_Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font_Size}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="{StaticResource Border_Width}" />
        <Setter Property="Background" Value="{DynamicResource App_SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App_ControlBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Control_FocusVisual}" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate_Secondary}" />
    </Style>

    <!-- Основная кнопка экрана: одно акцентное действие. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{DynamicResource App_AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App_AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App_AccentTextBrush}" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate_Accent}" />
    </Style>

    <!-- Второстепенная кнопка. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}" />

    <!-- Опасное действие: удаление, остановка. -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Brush_Error}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Error}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate_Accent}" />
    </Style>

    <!-- Кнопка панели действий: компактная, без рамки. -->
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="{StaticResource Margin_ButtonGap}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate_Toolbar}" />
    </Style>

    <!-- ===== Поля формы ===== -->

    <Style x:Key="FormLabel" TargetType="Label">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="{StaticResource Margin_Label}" />
        <Setter Property="FontFamily" Value="{StaticResource Font_Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font_Size}" />
        <Setter Property="Foreground" Value="{DynamicResource App_SecondaryTextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="FormTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource Control_Height}" />
        <Setter Property="Padding" Value="{StaticResource Padding_Form}" />
        <Setter Property="Margin" Value="{StaticResource Margin_Field}" />
        <Setter Property="FontFamily" Value="{StaticResource Font_Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font_Size}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource App_ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App_ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border_Width}" />
        <Setter Property="CaretBrush" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource App_AccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- Стандартный шаблон WPF: текст и каретка позиционируются корректно. -->
    </Style>

    <Style x:Key="FormPasswordBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="{StaticResource Control_Height}" />
        <Setter Property="Padding" Value="{StaticResource Padding_Form}" />
        <Setter Property="Margin" Value="{StaticResource Margin_Field}" />
        <Setter Property="FontFamily" Value="{StaticResource Font_Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font_Size}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource App_ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App_ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border_Width}" />
        <Setter Property="CaretBrush" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- Стандартный шаблон WPF: текст и каретка позиционируются корректно. -->
    </Style>

    <Style x:Key="FormComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource App_SelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource App_SelectionTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FormDatePicker" TargetType="DatePicker">
        <Setter Property="Height" Value="{StaticResource Control_Height}" />
        <Setter Property="Margin" Value="{StaticResource Margin_Field}" />
        <Setter Property="FontFamily" Value="{StaticResource Font_Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font_Size}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="FormComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource Control_Height}" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Margin" Value="{StaticResource Margin_Field}" />
        <Setter Property="Padding" Value="{StaticResource Padding_Form}" />
        <Setter Property="FontFamily" Value="{StaticResource Font_Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font_Size}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource App_ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App_ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border_Width}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Control_FocusVisual}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FormComboBoxItem}" />
        <!-- Стандартный шаблон WPF: цвета и выпадающий список системные. -->
    </Style>

    <Style x:Key="StatusBarStyle" TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource App_ToolbarBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App_BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="Padding" Value="4" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource App_SelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource App_SelectionTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource App_SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App_BorderBrush}" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource App_SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App_BorderBrush}" />
    </Style>

    <Style x:Key="FormCheckBox" TargetType="CheckBox">
        <Setter Property="Margin" Value="{StaticResource Margin_Field}" />
        <Setter Property="FontFamily" Value="{StaticResource Font_Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font_Size}" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Control_FocusVisual}" />
    </Style>

    <!-- ===== Таблица ===== -->

    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource App_SelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource App_SelectionTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="{StaticResource Control_Height}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontFamily" Value="{StaticResource Font_Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font_Size}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource App_GridHeaderBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App_BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Height" Value="{StaticResource Control_Height}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource App_GridAlternateRowBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource App_GridRowHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource App_SelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource App_SelectionTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource App_BorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource App_SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App_BorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border_Width}" />
        <Setter Property="RowHeight" Value="{StaticResource Control_Height}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource DataGridRowStyle}" />
    </Style>

    <!-- ===== Состояния ===== -->

    <!--
        Пустое состояние. Tag — заголовок, Content — пояснение и действия.
        Пример: <ContentControl Style="{StaticResource EmptyState}" Tag="{loc:Loc Main_EmptyTitle}">
                    <TextBlock Text="{loc:Loc Main_EmptyHint}"/>
                </ContentControl>
    -->
    <Style x:Key="EmptyState" TargetType="ContentControl">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Foreground" Value="{DynamicResource App_SecondaryTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Margin="{StaticResource Margin_Label}"
                                   FontFamily="{StaticResource Font_Ui}"
                                   FontSize="{StaticResource Font_Size_Header}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App_ForegroundBrush}"
                                   Text="{TemplateBinding Tag}" />
                        <ContentPresenter HorizontalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Баннер состояния: ошибка, предупреждение, успех, информация. -->
    <Style x:Key="StatusBanner" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource Padding_Panel}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="CornerRadius" Value="{StaticResource Corner_Radius}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border_Width}" />
        <Setter Property="Background" Value="{DynamicResource Status_InfoBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App_BorderBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource App_ForegroundBrush}" />
    </Style>

    <Style x:Key="StatusBannerError" TargetType="Border" BasedOn="{StaticResource StatusBanner}">
        <Setter Property="Background" Value="{DynamicResource Status_ErrorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Status_ErrorBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Status_ErrorBrush}" />
    </Style>

    <Style x:Key="StatusBannerWarning" TargetType="Border" BasedOn="{StaticResource StatusBanner}">
        <Setter Property="Background" Value="{DynamicResource Status_WarningBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Status_WarningBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Status_WarningBrush}" />
    </Style>

    <Style x:Key="StatusBannerSuccess" TargetType="Border" BasedOn="{StaticResource StatusBanner}">
        <Setter Property="Background" Value="{DynamicResource Status_SuccessBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Status_SuccessBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Status_SuccessBrush}" />
    </Style>

    <Style x:Key="StatusBannerInfo" TargetType="Border" BasedOn="{StaticResource StatusBanner}" />

    <!-- ===== Типографика ===== -->

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font_Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font_Size_Header}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font_Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font_Size_Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource App_SecondaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
