<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Иконочный шрифт (контракт UI.md: монохром, 16 px, Segoe Fluent Icons).
        На Windows 10 шрифт отсутствует, поэтому в Font_Icons указан fallback
        Segoe MDL2 Assets — кодовые точки совпадают.

        Иконка не должна быть единственным носителем смысла: рядом с глифом
        обязателен текст или AutomationProperties.Name.
    -->

    <sys:String x:Key="Glyph_Add">&#xE710;</sys:String>
    <sys:String x:Key="Glyph_Edit">&#xE70F;</sys:String>
    <sys:String x:Key="Glyph_Delete">&#xE74D;</sys:String>
    <sys:String x:Key="Glyph_Refresh">&#xE72C;</sys:String>
    <sys:String x:Key="Glyph_History">&#xE81C;</sys:String>
    <sys:String x:Key="Glyph_Run">&#xE768;</sys:String>
    <sys:String x:Key="Glyph_Save">&#xE74E;</sys:String>
    <sys:String x:Key="Glyph_Cancel">&#xE711;</sys:String>
    <sys:String x:Key="Glyph_Close">&#xE8BB;</sys:String>
    <sys:String x:Key="Glyph_Folder">&#xE8B7;</sys:String>
    <sys:String x:Key="Glyph_Trigger">&#xE823;</sys:String>
    <sys:String x:Key="Glyph_Settings">&#xE713;</sys:String>
    <sys:String x:Key="Glyph_Search">&#xE721;</sys:String>
    <sys:String x:Key="Glyph_ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Glyph_Info">&#xE946;</sys:String>
    <sys:String x:Key="Glyph_Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Glyph_Error">&#xE783;</sys:String>
    <sys:String x:Key="Glyph_Check">&#xE73E;</sys:String>
    <sys:String x:Key="Glyph_Shield">&#xEA18;</sys:String>
    <sys:String x:Key="Glyph_More">&#xE712;</sys:String>
    <sys:String x:Key="Glyph_OpenLog">&#xE8A7;</sys:String>

    <!-- Базовый стиль глифа. Размер — токен Icon_Size, цвет наследуется от темы. -->
    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font_Icons}" />
        <Setter Property="FontSize" Value="{StaticResource Icon_Size}" />
        <Setter Property="Foreground" Value="{DynamicResource App_ForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Глиф на акцентном фоне (основные кнопки). -->
    <Style x:Key="IconTextOnAccent" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
        <Setter Property="Foreground" Value="{DynamicResource App_AccentTextBrush}" />
    </Style>

</ResourceDictionary>
