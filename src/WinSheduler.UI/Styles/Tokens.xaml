<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Примитивные токены дизайн-системы (контракт UI.md, раздел 2).
        Семантические кисти темы — в Theme.Light.xaml / Theme.Dark.xaml.
        Стили контролов ссылаются на токены через StaticResource,
        на кисти темы — только через DynamicResource.
    -->

    <!-- Отступы -->
    <sys:Double x:Key="Space_4">4</sys:Double>
    <sys:Double x:Key="Space_8">8</sys:Double>
    <sys:Double x:Key="Space_12">12</sys:Double>
    <sys:Double x:Key="Space_16">16</sys:Double>
    <sys:Double x:Key="Space_24">24</sys:Double>

    <Thickness x:Key="Padding_Button">12,4</Thickness>
    <Thickness x:Key="Padding_Form">6,4</Thickness>
    <Thickness x:Key="Padding_Panel">12</Thickness>
    <Thickness x:Key="Margin_Field">0,0,0,8</Thickness>
    <Thickness x:Key="Margin_Label">0,0,0,4</Thickness>
    <Thickness x:Key="Margin_ButtonGap">0,0,8,0</Thickness>

    <!-- Размеры -->
    <sys:Double x:Key="Control_Height">28</sys:Double>
    <sys:Double x:Key="Icon_Size">16</sys:Double>
    <sys:Double x:Key="Button_MinWidth">90</sys:Double>
    <sys:Double x:Key="Radius">4</sys:Double>
    <Thickness x:Key="Border_Width">1</Thickness>
    <sys:Double x:Key="Window_MinWidth">1024</sys:Double>
    <sys:Double x:Key="Window_MinHeight">700</sys:Double>

    <CornerRadius x:Key="Corner_Radius">4</CornerRadius>

    <!-- Шрифты -->
    <FontFamily x:Key="Font_Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Font_Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="Font_Size">12</sys:Double>
    <sys:Double x:Key="Font_Size_Header">16</sys:Double>
    <sys:Double x:Key="Font_Size_Caption">11</sys:Double>

    <!-- Цвета статусов (контракт UI.md). В тёмной теме используются
         осветлённые варианты для контраста 4.5:1 — см. Theme.Dark.xaml. -->
    <Color x:Key="Color_Success">#107C10</Color>
    <Color x:Key="Color_Error">#C42B1C</Color>
    <Color x:Key="Color_Warning">#9D5D00</Color>

    <SolidColorBrush x:Key="Brush_Success" Color="{StaticResource Color_Success}" />
    <SolidColorBrush x:Key="Brush_Error" Color="{StaticResource Color_Error}" />
    <SolidColorBrush x:Key="Brush_Warning" Color="{StaticResource Color_Warning}" />

    <!-- Прозрачные кисти для шаблонов -->
    <SolidColorBrush x:Key="Brush_Transparent" Color="Transparent" />

</ResourceDictionary>
