<Window x:Class="WinSheduler.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSheduler - Управление заданиями" Height="600" Width="980"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" Text="Служба: проверка..." VerticalAlignment="Center" Margin="0,0,20,6" FontWeight="Bold"/>            <Button x:Name="RefreshBtn" Click="RefreshBtn_Click" Width="130" Margin="0,0,10,6">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconRefresh}" Width="32" Height="32" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    <TextBlock Text="Обновить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="AddBtn" Click="AddBtn_Click" Width="130" Margin="0,0,10,6">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconAdd}" Width="32" Height="32" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="EditBtn" Click="EditBtn_Click" Width="130" Margin="0,0,10,6" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconEdit}" Width="32" Height="32" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    <TextBlock Text="Изменить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="DeleteBtn" Click="DeleteBtn_Click" Width="110" Margin="0,0,10,6" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconDelete}" Width="32" Height="32" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="HistoryBtn" Click="HistoryBtn_Click" Width="110" Margin="0,0,0,6" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconHistory}" Width="32" Height="32" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    <TextBlock Text="Журнал" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="RunNowBtn" Click="RunNowBtn_Click" Width="110" Margin="10,0,0,6" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconStart}" Width="32" Height="32" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    <TextBlock Text="Запустить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- Баннер: служба недоступна (первый запуск или остановленная служба) -->
        <Border x:Name="OfflineBanner" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10"
                Padding="12,8" CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}">
            <StackPanel>
                <TextBlock Text="Служба WinSheduler недоступна" FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"/>
                <TextBlock x:Name="OfflineDetail" TextWrapping="Wrap" Margin="0,4,0,8"
                           Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RetryBtn" Content="Повторить" MinWidth="90" Padding="12,4"
                            Margin="0,0,8,0" Click="RetryBtn_Click"/>
                    <Button x:Name="OpenServicesBtn" Content="Открыть службы" MinWidth="120" Padding="12,4"
                            Click="OpenServicesBtn_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListView x:Name="TaskListView"
                      SelectionMode="Single"
                      SelectionChanged="TaskListView_SelectionChanged"
                      MouseDoubleClick="TaskListView_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="200"/>
                        <GridViewColumn Header="Программа" DisplayMemberBinding="{Binding ProgramPath}" Width="250"/>
                        <GridViewColumn Header="Статус" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Enabled, Converter={StaticResource BoolToStatusConverter}}" Foreground="{Binding Enabled, Converter={StaticResource BoolToColorConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Расписание" DisplayMemberBinding="{Binding ScheduleSummary}" Width="200"/>
                        <GridViewColumn Header="Посл. запуск" DisplayMemberBinding="{Binding LastRun}" Width="120"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Пустое состояние: задач ещё нет -->
            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <TextBlock Text="Задач пока нет" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Создайте первую задачу — служба будет выполнять её по расписанию в фоне."
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,12"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <Button Content="Добавить задачу" MinWidth="130" Padding="12,4"
                        HorizontalAlignment="Center" Click="AddBtn_Click"/>
            </StackPanel>
        </Grid>

        <StatusBar Grid.Row="3" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="Готов"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="Диагностика" MinWidth="100" Padding="12,2"
                        Click="DiagnosticsBtn_Click"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
