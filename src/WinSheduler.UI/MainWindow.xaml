<Window x:Class="WinSheduler.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WinSheduler.UI.Localization"
        xmlns:vm="clr-namespace:WinSheduler.UI.ViewModels"
        Title="{loc:Loc Main_Title}" Height="600" Width="980"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска, фильтра и действий -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Main_SearchLabel}" Style="{StaticResource CaptionText}" Margin="0,0,6,0"/>
                <TextBox x:Name="SearchBox" Width="220" Margin="0,0,12,6"
                         Style="{StaticResource FormTextBox}"
                         ToolTip="{loc:Loc Main_SearchPlaceholder}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{loc:Loc Main_FilterLabel}" Style="{StaticResource CaptionText}" Margin="0,0,6,0"/>
                <ComboBox x:Name="FilterBox" Width="150" Margin="0,0,0,6"
                          Style="{StaticResource FormComboBox}"
                          SelectedValue="{Binding Filter, Mode=TwoWay}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="{loc:Loc Main_FilterAll}" Tag="{x:Static vm:TaskFilter.All}"/>
                    <ComboBoxItem Content="{loc:Loc Main_FilterMine}" Tag="{x:Static vm:TaskFilter.Mine}"/>
                    <ComboBoxItem Content="{loc:Loc Main_FilterEnabled}" Tag="{x:Static vm:TaskFilter.Enabled}"/>
                    <ComboBoxItem Content="{loc:Loc Main_FilterDisabled}" Tag="{x:Static vm:TaskFilter.Disabled}"/>
                </ComboBox>
            </WrapPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="RefreshBtn" Command="{Binding RefreshCommand}"
                        Style="{StaticResource ToolbarButton}"
                        Content="{loc:Loc Main_ActionRefresh}"
                        ToolTip="{loc:Loc Main_ActionRefresh}"
                        Margin="0,0,6,6"/>
                <Button x:Name="AddBtn" Click="AddBtn_Click"
                        Style="{StaticResource ToolbarButton}"
                        Content="{loc:Loc Main_ActionAdd}"
                        Margin="0,0,6,6"/>
                <Button x:Name="EditBtn" Click="EditBtn_Click"
                        Style="{StaticResource ToolbarButton}"
                        Content="{loc:Loc Main_ActionEdit}"
                        Margin="0,0,6,6"/>
                <Button x:Name="DeleteBtn" Click="DeleteBtn_Click"
                        Style="{StaticResource ToolbarButton}"
                        Content="{loc:Loc Main_ActionDelete}"
                        Margin="0,0,6,6"/>
                <Button x:Name="HistoryBtn" Click="HistoryBtn_Click"
                        Style="{StaticResource ToolbarButton}"
                        Content="{loc:Loc Main_ActionHistory}"
                        Margin="0,0,6,6"/>
                <Button x:Name="RunNowBtn" Click="RunNowBtn_Click"
                        Style="{StaticResource ToolbarButton}"
                        Content="{loc:Loc Main_ActionRun}"
                        Margin="0,0,6,6"/>
                <Button x:Name="ToggleBtn" Click="ToggleBtn_Click"
                        Style="{StaticResource ToolbarButton}"
                        Content="{loc:Loc Main_ActionToggle}"
                        Margin="0,0,0,6"/>
            </WrapPanel>
        </Grid>

        <!-- Ошибка загрузки / служба недоступна -->
        <Border Grid.Row="1" Style="{StaticResource StatusBannerError}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"/>
                <TextBlock Text="{loc:Loc Main_ServiceUnavailableHint}" TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Visibility="{Binding IsServiceUnavailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{loc:Loc Common_Retry}" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Main_OpenServices}" Click="OpenServicesBtn_Click"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Ошибка действия (удаление, запуск, переключение) -->
        <Border x:Name="ActionBanner" Grid.Row="2" Style="{StaticResource StatusBannerError}"
                Visibility="Collapsed">
            <TextBlock x:Name="ActionBannerText" TextWrapping="Wrap"/>
        </Border>

        <!-- Список задач -->
        <Grid Grid.Row="3">
            <DataGrid x:Name="TaskGrid"
                      Style="{StaticResource DataGridStyle}"
                      ItemsSource="{Binding TasksView}"
                      SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                      MouseDoubleClick="TaskGrid_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc Main_ActionRefresh}" Click="RefreshMenu_Click"/>
                        <MenuItem Header="{loc:Loc Main_ActionAdd}" Click="AddBtn_Click"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc Main_ActionEdit}" Click="EditBtn_Click"/>
                        <MenuItem Header="{loc:Loc Main_ActionDelete}" Click="DeleteBtn_Click"/>
                        <MenuItem Header="{loc:Loc Main_ActionHistory}" Click="HistoryBtn_Click"/>
                        <MenuItem Header="{loc:Loc Main_ActionRun}" Click="RunNowBtn_Click"/>
                        <MenuItem Header="{loc:Loc Main_ActionToggle}" Click="ToggleBtn_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Main_ColumnName}" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="{loc:Loc Main_ColumnProgram}" Binding="{Binding ProgramPath}" Width="240"/>
                    <DataGridTextColumn Header="{loc:Loc Main_ColumnOwner}" Binding="{Binding OwnerLabel}" Width="120"/>
                    <DataGridTemplateColumn Header="{loc:Loc Main_ColumnStatus}" Width="110" SortMemberPath="Enabled">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Main_Running}"
                                               Foreground="{DynamicResource App_AccentBrush}"
                                               Visibility="{Binding Running, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Enabled, Converter={StaticResource BoolToStatusConverter}}"
                                               Foreground="{Binding Enabled, Converter={StaticResource BoolToColorConverter}}"
                                               Visibility="{Binding Running, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Loc Main_ColumnSchedule}" Binding="{Binding ScheduleSummary}" Width="200"/>
                    <DataGridTextColumn Header="{loc:Loc Main_ColumnLastRun}" Width="140"
                                        Binding="{Binding LastRun.StartTime, Converter={StaticResource LocalDateTimeConverter}, ConverterParameter=dd.MM.yyyy HH:mm}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Пустое состояние -->
            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource SectionHeader}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource App_SecondaryTextBrush}"/>
                <Button x:Name="EmptyAddBtn" Content="{loc:Loc Main_EmptyAdd}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Click="AddBtn_Click"/>
            </StackPanel>

            <ProgressBar Height="4" VerticalAlignment="Top" IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <!-- Статус-бар -->
        <StatusBar Grid.Row="4" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusSummaryText" Text="{loc:Loc Main_StatusServiceChecking}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatusBannerWarning}" Padding="8,2" Margin="0,0,8,0"
                            Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="{loc:Loc Status_RequiresAdmin}"/>
                    </Border>
                    <Button Content="{loc:Loc Admin_Relaunch}" Click="RelaunchBtn_Click"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <Button Content="{loc:Loc Main_ActionDiagnostics}" Click="DiagnosticsBtn_Click"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
