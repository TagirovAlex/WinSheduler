<Window x:Class="WinSheduler.UI.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WinSheduler.UI.Localization"
        Title="{loc:Loc Exchange_ImportTitle}" Height="600" Width="780"
        MinHeight="440" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App_BackgroundBrush}"
        Foreground="{DynamicResource App_ForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText" Grid.Row="0"
                   Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Border x:Name="WarningPanel" Grid.Row="1"
                Style="{StaticResource StatusBannerWarning}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Exchange_WarningsTitle}"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="WarningsText" TextWrapping="Wrap"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <DataGrid x:Name="TasksGrid" Grid.Row="2"
                  Style="{StaticResource DataGridStyle}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Exchange_ColumnName}"
                                    Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="{loc:Loc Exchange_ColumnTriggers}"
                                    Binding="{Binding TriggersText}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="{loc:Loc Exchange_ColumnEnabled}"
                                    Binding="{Binding EnabledText}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="{loc:Loc Exchange_ColumnPassword}"
                                    Binding="{Binding PasswordText}" Width="100" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc Exchange_ModeLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ModeBox" Width="280"
                          Style="{StaticResource FormComboBox}"
                          DisplayMemberPath="Label"/>
            </StackPanel>
            <ProgressBar x:Name="ImportProgress" Height="6" Margin="0,8,0,0"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ImportBtn"
                    Style="{StaticResource PrimaryButton}"
                    Click="ImportBtn_Click" IsDefault="True" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconImport}" Width="16" Height="16" Margin="0,0,6,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{loc:Loc Exchange_ImportButton}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelBtn"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelBtn_Click" IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconCancel}" Width="16" Height="16" Margin="0,0,6,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{loc:Loc Exchange_CancelButton}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
