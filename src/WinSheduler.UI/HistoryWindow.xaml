<Window x:Class="WinSheduler.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WinSheduler.UI.Localization"
        Title="{loc:Loc History_Title}" Height="520" Width="820"
        MinHeight="360" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App_BackgroundBrush}"
        Foreground="{DynamicResource App_ForegroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc History_FilterLabel}" Style="{StaticResource CaptionText}" Margin="0,0,6,0"/>
            <ComboBox x:Name="StatusFilterBox" Width="180" Margin="0,0,12,6"
                      Style="{StaticResource FormComboBox}"
                      DisplayMemberPath="Label" SelectionChanged="StatusFilterBox_SelectionChanged"/>
            <Button x:Name="RefreshBtn" Content="{loc:Loc Common_Refresh}"
                    Style="{StaticResource ToolbarButton}" Margin="0,0,6,6"
                    Click="RefreshBtn_Click" ToolTip="{loc:Loc History_RefreshTooltip}"/>
            <Button x:Name="ExportBtn" Content="{loc:Loc History_ExportCsv}"
                    Style="{StaticResource ToolbarButton}" Margin="0,0,6,6"
                    Click="ExportBtn_Click" IsEnabled="False"/>
            <Button x:Name="OpenLogBtn" Content="{loc:Loc History_OpenLog}"
                    Style="{StaticResource ToolbarButton}" Margin="0,0,0,6"
                    Click="OpenLogBtn_Click" IsEnabled="False"/>
        </WrapPanel>

        <Border x:Name="Banner" Grid.Row="1" Style="{StaticResource StatusBannerError}" Visibility="Collapsed">
            <TextBlock x:Name="BannerText" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid x:Name="HistoryGrid"
                      Style="{StaticResource DataGridStyle}"
                      SelectionChanged="HistoryGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc History_ColumnStart}"
                                        Binding="{Binding StartText}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{loc:Loc History_ColumnEnd}"
                                        Binding="{Binding EndText}" Width="150" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="{loc:Loc History_ColumnStatus}" Width="120" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding Status, Converter={StaticResource RunStatusToBrushConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Loc History_ColumnExitCode}"
                                        Binding="{Binding ExitCodeText}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{loc:Loc History_ColumnDuration}"
                                        Binding="{Binding DurationText}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{loc:Loc History_ColumnError}"
                                        Binding="{Binding ErrorMessage}" Width="220" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyText" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource App_SecondaryTextBrush}"/>
        </Grid>

        <TextBlock x:Name="StatusLine" Grid.Row="3" Margin="0,8,0,0"
                   Style="{StaticResource CaptionText}"/>
    </Grid>
</Window>
