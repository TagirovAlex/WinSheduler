<?xml version="1.0" encoding="utf-8"?>
<!--
  Основной файл пакета WinSheduler (WiX 5, per-machine MSI).
  Контракт: ./docs/contracts/INSTALL.md, ADR: ./docs/adr/0002-installer-and-layout.md.

  Версия передаётся из ./scripts/installer/build.ps1 (git-тег) через -d ProductVersion.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="WinSheduler"
           Manufacturer="WinSheduler"
           Version="$(var.ProductVersion)"
           UpgradeCode="{B4E1C7A2-9F3D-4C58-8A61-2D7E5F0B9C43}"
           Scope="perMachine"
           Compressed="yes"
           Codepage="1251"
           InstallerVersion="500">

    <!-- Изображения и лицензия для диалогов WixUI_InstallDir. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- Major upgrade: старый продукт удаляется после InstallValidate; downgrade запрещён. -->
    <MajorUpgrade Schedule="afterInstallValidate"
                  DowngradeErrorMessage="Установлена более новая версия WinSheduler. Понижение версии не поддерживается." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Публичные свойства (доступны для silent install и GPO/Intune). -->
    <Property Id="CREATEGROUP" Value="1" />
    <Property Id="ADDINSTALLERTOGROUP" Value="1" />
    <Property Id="STARTUI" Value="0" />
    <Property Id="KEEPDATA" Value="1" />
    <Property Id="ALLOWUNSAFEPATH" Value="0" />

    <!--
      INSTALLDIR и DATADIR читаются из реестра предыдущей установки, чтобы repair и
      upgrade сохраняли выбранные пути. Значения из командной строки имеют приоритет:
      AppSearch не перезаписывает уже заданное свойство.
    -->
    <Property Id="INSTALLDIR">
      <RegistrySearch Id="InstallDirSearch" Root="HKLM" Key="SOFTWARE\WinSheduler"
                      Name="InstallDir" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="DATADIR">
      <RegistrySearch Id="DataDirSearch" Root="HKLM" Key="SOFTWARE\WinSheduler"
                      Name="DataDir" Type="raw" Bitness="always64" />
    </Property>

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCOMMENTS" Value="Планировщик задач WinSheduler" />

    <!-- Немедленные действия, передающие данные отложенным действиям. -->
    <CustomAction Id="SetApplySecurity" Property="ApplySecurity"
                  Value="installdir=[INSTALLDIR];datadir=[DATADIR];creategroup=[CREATEGROUP];addinstaller=[ADDINSTALLERTOGROUP];userdomain=[%USERDOMAIN];username=[%USERNAME];version=[ProductVersion]" />
    <CustomAction Id="SetConfigureService" Property="ConfigureService"
                  Value="serviceexe=[SVCDIR]WinShedulerSvc.exe;datadir=[DATADIR]" />
    <CustomAction Id="SetMigrateData" Property="MigrateData"
                  Value="olddatadir=[OLDDATADIR];datadir=[DATADIR]" />
    <CustomAction Id="SetRemoveData" Property="RemoveData"
                  Value="datadir=[DATADIR];keepdata=[KEEPDATA]" />
    <CustomAction Id="SetLaunchUi" Property="LaunchUi"
                  Value="uipath=[UIDIR]WinSheduler.UI.exe" />

    <Icon Id="AppIcon" SourceFile="$(var.UiIcon)" />

    <Launch Condition="Installed OR Privileged"
            Message="Для установки WinSheduler требуются права администратора." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="WinSheduler">
        <Directory Id="SVCDIR" Name="service" />
        <Directory Id="UIDIR" Name="ui" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIR" Name="WinSheduler" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="WinSheduler" />
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="WinSheduler" Level="1">
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="UiComponents" />
      <ComponentGroupRef Id="DocumentationComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLDIR" />

    <InstallUISequence>
      <Custom Action="ValidatePaths" After="CostFinalize" Condition="NOT Installed" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <Custom Action="ValidatePaths" After="CostFinalize" Condition="NOT Installed" />
      <Custom Action="SetApplySecurity" Before="ApplySecurity" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="ApplySecurity" Before="InstallFiles" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="SetMigrateData" Before="MigrateData" Condition="NOT Installed" />
      <Custom Action="MigrateData" After="ApplySecurity" Condition="NOT Installed" />
      <Custom Action="SetConfigureService" Before="ConfigureService" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="ConfigureService" Before="StartServices" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="SetLaunchUi" Before="LaunchUi" Condition="STARTUI=&quot;1&quot; AND NOT Installed" />
      <Custom Action="LaunchUi" Before="InstallFinalize" Condition="STARTUI=&quot;1&quot; AND NOT Installed" />
      <Custom Action="SetRemoveData" Before="RemoveData" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveData" After="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
